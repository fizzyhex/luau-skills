{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "lune run \"${CLAUDE_PLUGIN_ROOT}/hooks/lint-guard.luau\""
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "lune run \"${CLAUDE_PLUGIN_ROOT}/hooks/lint.luau\""
					},
					{
						"type": "command",
						"command": "lune run \"${CLAUDE_PLUGIN_ROOT}/hooks/type-check.luau\""
					}
				]
			}
		],
		"Stop": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "lune run \"${CLAUDE_PLUGIN_ROOT}/hooks/lint-stop.luau\""
					},
					{
						"type": "command",
						"command": "lune run \"${CLAUDE_PLUGIN_ROOT}/hooks/type-check-stop.luau\""
					}
				]
			}
		],
		"PostToolBatch": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "lune run \"${CLAUDE_PLUGIN_ROOT}/hooks/lint-batch.luau\""
					}
				]
			}
		],
		"SubagentStop": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "lune run \"${CLAUDE_PLUGIN_ROOT}/hooks/lint-subagent-stop.luau\""
					}
				]
			}
		],
		"TaskCompleted": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "lune run \"${CLAUDE_PLUGIN_ROOT}/hooks/lint-task-completed.luau\""
					}
				]
			}
		],
		"SessionStart": [
			{
				"matcher": "startup|resume|clear|compact",
				"hooks": [
					{
						"type": "command",
						"command": "lune run \"${CLAUDE_PLUGIN_ROOT}/hooks/clear-lint-state.luau\""
					}
				]
			}
		]
	}
}
