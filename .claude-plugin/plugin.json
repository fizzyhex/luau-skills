{
	"name": "sentinel-luau",
	"description": "Luau development workflows: StyLua + selene lint hooks and luau-lsp type-check hooks, written in typed Luau on Lune",
	"version": "2.0.0",
	"author": {
		"name": "Fizzy",
		"url": "https://github.com/fizzyhex"
	},
	"homepage": "https://github.com/fizzyhex/luau-skills",
	"repository": "https://github.com/fizzyhex/luau-skills",
	"license": "MIT",
	"keywords": ["luau", "roblox", "lune", "selene", "stylua", "luau-lsp", "workflows"],
	"skills": "./no-op/",
	"outputStyles": "./output-styles/",
	"lspServers": {
		"luau": {
			"command": "luau-lsp",
			"args": ["lsp"],
			"diagnostics": false,
			"extensionToLanguage": {
				".lua": "lua",
				".luau": "luau"
			}
		}
	}
}
