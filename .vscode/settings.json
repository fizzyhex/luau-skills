{
	"search.exclude": {
		"sources/**": true,
		"vendor/**": true
	},
	"files.associations": {
		"*.luau": "luau"
	},
	"[luau]": {
		"editor.defaultFormatter": "JohnnyMorganz.stylua",
		"editor.formatOnSave": true
	},
	"luau-lsp.platform.type": "standard",
	"luau-lsp.sourcemap.enabled": false,
	"luau-lsp.require.mode": "relativeToFile",
	"selene.run": "onType"
}
